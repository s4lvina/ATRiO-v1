# Configuración de base de datos
DATABASE_URL=sqlite:///./database/secure/atrio.db

# Configuración de seguridad
SECRET_KEY=dev-secret-key-change-in-production-please
ALGORITHM=HS256

# Configuración de sesión
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configuración del servidor (DESARROLLO LOCAL)
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Configuración de API (DESARROLLO LOCAL)
# Para Docker/producción: cambiar a IP/dominio real
VITE_API_URL=http://localhost:8000

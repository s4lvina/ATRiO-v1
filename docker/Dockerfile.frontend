FROM node:20-alpine

WORKDIR /app

# Copiar package.json y package-lock.json
COPY package*.json ./

# Instalar dependencias
# Usar npm install en lugar de npm ci para evitar problemas con dependencias nativas en Alpine
# Si tienes package-lock.json, considere usar: npm ci --legacy-peer-deps
RUN npm install --legacy-peer-deps

# Copiar código
COPY . .

# Build
RUN npm run build

# Exponer puerto
EXPOSE 3000

# Servir con preview (para producción simple)
CMD ["npm", "run", "preview"]
# Para desarrollo: npm run dev
CMD ["npm", "run", "preview"]

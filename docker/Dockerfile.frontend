FROM node:20-alpine

# Recibir VITE_API_URL como argumento de build
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

WORKDIR /app

# Instalar herramientas de compilación necesarias para dependencias nativas en Alpine
# (python, make, g++ son requeridos por algunos paquetes npm)
RUN apk add --no-cache python3 make g++

# Copiar package.json y package-lock.json
COPY package*.json ./

# Limpiar si existen versiones previas, luego instalar
# Esto asegura que Rollup y otras dependencias nativas se recompilen con herramientas disponibles
RUN rm -rf node_modules package-lock.json && \
    npm install --legacy-peer-deps

# Copiar código
COPY . .

# Crear .env con VITE_API_URL para que Vite lo encuentre durante la compilación
RUN echo "VITE_API_URL=${VITE_API_URL}" > .env

# Build Vite - ahora lee .env con la variable correcta
RUN npm run build

# Exponer puerto
EXPOSE 3000

# Servir con preview (para producción)
CMD ["npm", "run", "preview"]

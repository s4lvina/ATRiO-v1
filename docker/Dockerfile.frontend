FROM node:20-alpine

WORKDIR /app

# Instalar herramientas de compilación necesarias para dependencias nativas en Alpine
# (python, make, g++ son requeridos por algunos paquetes npm)
RUN apk add --no-cache python3 make g++

# Copiar package.json y package-lock.json
COPY package*.json ./

# Limpiar si existen versiones previas, luego instalar
# Esto asegura que Rollup y otras dependencias nativas se recompilen con herramientas disponibles
RUN rm -rf node_modules package-lock.json && \
    npm install --legacy-peer-deps

# Copiar código
COPY . .

# Build Vite
RUN npm run build

# Exponer puerto
EXPOSE 3000

# Servir con preview (para producción)
CMD ["npm", "run", "preview"]
